{
  "info": {
    "name": "CreatorFlow API - Complete Demo",
    "description": "Set baseUrl=http://localhost:3000. Workflow: create content and use returned ID for start -> submit-review -> approve -> schedule -> publish.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Create carousel post\",\n  \"description\": \"Prepare visuals\",\n  \"projectId\": \"project_001\",\n  \"assigneeId\": \"user_002\",\n  \"priority\": \"high\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get seeded task",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/task_001"
      }
    },
    {
      "name": "Update seeded task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/task_001",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated through Postman\",\n  \"status\": \"in_progress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete seeded task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/task_040"
      }
    },
    {
      "name": "Filtered tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks?status=pending&priority=high"
      }
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "List campaigns",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/campaigns"
      }
    },
    {
      "name": "List contents",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/contents"
      }
    },
    {
      "name": "Create content",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/contents",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"campaignId\": \"campaign_001\",\n  \"title\": \"Fresh campaign idea\",\n  \"type\": \"carousel\",\n  \"platform\": \"instagram\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Content approvals",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/contents/content_004/approvals"
      }
    },
    {
      "name": "Calendar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/calendar?month=2026-10"
      }
    },
    {
      "name": "Summary report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reports/summary"
      }
    },
    {
      "name": "Project report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reports/projects/project_001"
      }
    },
    {
      "name": "Overdue tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reports/overdue"
      }
    },
    {
      "name": "Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users"
      }
    }
  ]
}